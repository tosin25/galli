  "exercise": { "treatment": "shaded", "head": "band", "color": "secondary", "fill": "secondary_tint", "radius": 0, "answer_lines": "line" },
  "note": { "treatment": "shaded", "fill": "note", "label_color": "primary", "icon": "", "radius": 2 },
  "table": { "head_fill": "secondary", "head_text": "paper", "stroke": "line", "zebra": "secondary_tint" },
  "list": { "bullet_color": "accent" },
  "folio": { "position": "outer", "shape": "block", "color": "primary", "text": "paper" },
  "header": { "show": true, "left": "book", "right": "chapter", "rule": false, "color": "primary" },
  "side_tab": { "show": true, "color": "accent", "text": "paper", "width": 7, "height": 30 },
  "figures": { "max_width": 0.62, "min_scale": 0.6 },
