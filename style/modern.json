  "opener": { "layout": "band", "height": 96, "color": "primary", "label": "CHAPTER", "character": "seedling.png", "decor": "number", "objectives": { "fill": "secondary_tint", "head": "primary" } },
  "h2": { "treatment": "number_rule", "color": "primary", "text": "secondary" },
