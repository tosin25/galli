    "body": { "family": "Google Sans", "regular": "Regular", "bold": "Bold", "italic": "Italic" }
  },
  "type": { "body": 10.5, "leading": 15.5, "h2": 17, "h3": 12, "box_head": 10.5, "small": 9, "caption": 8.5, "opener_title": 34, "opener_number": 72, "header": 7.5, "folio": 9 },
  "palette": {
    "primary": "#2D6A4F", "secondary": "#1F2933", "accent": "#52B788", "ink": "#1F2933",
